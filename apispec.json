      "post": {
        "parameters": [
          {
            "description": "Bearer Token",
            "example": "Bearer <your_token>",
            "in": "header",
            "name": "Authorization",
            "required": true,
            "type": "string"
          },
          {
            "in": "body",
            "name": "body",
            "required": true,
            "schema": {
              "properties": {
                "actity_datetime": {
                  "example": "07:00:00",
                  "type": "string"
                },
                "actity_desc": {
                  "example": "30 minutes walking",
                  "type": "string"
                },
                "actity_name": {
                  "example": "Morning Exercise",
                  "type": "string"
                },
                "actity_status": {
                  "example": 1,
                  "type": "integer"
                },
                "actity_type": {
                  "example": "Medicine",
                  "type": "string"
                },
                "days_flag": {
                  "example": [
                    "0"
                  ],
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "patient_id": {
                  "example": 101,
                  "type": "integer"
                }
              },
              "type": "object"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Activity created successfully"
